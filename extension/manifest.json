{
  "manifest_version": 3,
  "name": "Claude Extractor",
  "version": "1.4.0",
  "homepage_url": "https://github.com/KshRaven/claude-extractor",
  "description": "Export claude.ai chats, projects, tool calls and artifacts as a clean zip.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": { "id": "claude-extractor@local", "strict_min_version": "115.0" }
  },
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["lib/zip.js", "lib/format.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Claude Extractor",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
